<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" oor:name="Jobs" oor:package="org.openoffice.Office">
  <node oor:name="Jobs">
    <node oor:name="MoleculeStudioDocumentView" oor:op="replace">
      <prop oor:name="Service"><value>org.moleculestudio.office.RegisterDrawingMouseHandler</value></prop>
    </node>
  </node>
  <node oor:name="Events">
    <node oor:name="onDocumentOpened" oor:op="fuse">
      <node oor:name="JobList"><node oor:name="MoleculeStudioDocumentView" oor:op="replace"/></node>
    </node>
  </node>
</oor:component-data>
