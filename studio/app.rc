#include <windows.h>
1 ICON "assets/app-icons/moleculestudio-professional.ico"
1 VERSIONINFO
FILEVERSION 1,0,4,0
PRODUCTVERSION 1,0,4,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MoleculeStudio Portable\0"
            VALUE "FileVersion", "1.0.4.0\0"
            VALUE "InternalName", "MoleculeStudio\0"
            VALUE "OriginalFilename", "MoleculeStudio.exe\0"
            VALUE "ProductName", "MoleculeStudio\0"
            VALUE "ProductVersion", "1.0.4.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
1 RT_MANIFEST "app.manifest"

#pragma code_page(65001)
601 DIALOGEX 0,0,380,214
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "歧义官能团选择"
FONT 9,"Microsoft YaHei UI"
BEGIN
 COMBOBOX 1101,10,9,360,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 COMBOBOX 1102,10,31,300,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 CONTROL "",1104,"Static",SS_OWNERDRAW | WS_BORDER,10,31,360,138
 CONTROL "以后此缩写都使用这个选项",1103,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,173,250,15
 DEFPUSHBUTTON "确定",IDOK,195,191,54,16
 PUSHBUTTON "取消",IDCANCEL,256,191,54,16
END
