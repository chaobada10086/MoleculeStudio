<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MoleculeStudio · 安装与组件管理" Width="850" Height="840" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Background="#F5F8F8" FontFamily="Microsoft YaHei UI" Foreground="#143B3A">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#E6EFED"/><Setter Property="Foreground" Value="#174C47"/><Setter Property="Padding" Value="18,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="FontSize" Value="16"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 
 <Style x:Key="ComponentCard" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Card" Background="White" BorderBrush="#DEE9E5" BorderThickness="2" CornerRadius="12" Padding="18,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="30" Height="30" CornerRadius="6" BorderBrush="#93B3AA" BorderThickness="2" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock x:Name="Tick" Text="✓" FontSize="24" FontWeight="Bold" Foreground="White" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter Grid.Column="1"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="Background" Value="#157D70"/><Setter TargetName="Box" Property="BorderBrush" Value="#157D70"/><Setter TargetName="Card" Property="BorderBrush" Value="#157D70"/><Setter TargetName="Card" Property="Background" Value="#ECF7F2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
 <Grid Margin="36,28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="MOLECULE STUDIO" FontSize="12" FontWeight="Bold" Foreground="#268C80"/><TextBlock Text="让灵感，成为结构。" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,7"/><TextBlock Text="勾选要操作的组件，再点击安装或卸载。核心依赖会自动按顺序处理。" Foreground="#637B78" FontSize="13"/></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,24,0,0">
<CheckBox x:Name="Pick0" Style="{StaticResource ComponentCard}" Margin="0,0,0,0"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="核心工作台" FontSize="17" FontWeight="SemiBold"/><Border Background="#E0EDE7" CornerRadius="5" Padding="8,3" Margin="12,0,0,0"><TextBlock x:Name="State0" Text="检测中…" FontSize="12"/></Border></StackPanel><TextBlock Text="结构绘图 · 化学命名 · 核磁预测 · 三维构象" Foreground="#637B78" FontSize="12" Margin="0,6,0,0"/><TextBlock x:Name="Hint0" FontSize="11" Foreground="#718784" Margin="0,5,0,0"/></StackPanel></CheckBox>
<CheckBox x:Name="Pick1" Style="{StaticResource ComponentCard}" Margin="0,10,0,0"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="AI 助手" FontSize="17" FontWeight="SemiBold"/><Border Background="#E0EDE7" CornerRadius="5" Padding="8,3" Margin="12,0,0,0"><TextBlock x:Name="State1" Text="检测中…" FontSize="12"/></Border></StackPanel><TextBlock Text="对话辅助 · 高级绘图；需配置自己的 AI 服务" Foreground="#637B78" FontSize="12" Margin="0,6,0,0"/><TextBlock x:Name="Hint1" FontSize="11" Foreground="#718784" Margin="0,5,0,0"/></StackPanel></CheckBox>
<CheckBox x:Name="Pick2" Style="{StaticResource ComponentCard}" Margin="0,10,0,0"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="图片识别" FontSize="17" FontWeight="SemiBold"/><Border Background="#E0EDE7" CornerRadius="5" Padding="8,3" Margin="12,0,0,0"><TextBlock x:Name="State2" Text="检测中…" FontSize="12"/></Border></StackPanel><TextBlock Text="图片 / PDF 转可编辑结构 · 本地运行" Foreground="#637B78" FontSize="12" Margin="0,6,0,0"/><TextBlock x:Name="Hint2" FontSize="11" Foreground="#718784" Margin="0,5,0,0"/></StackPanel></CheckBox>
  </StackPanel>
  <StackPanel Grid.Row="2" Margin="0,20,0,0"><TextBlock Text="安装位置" FontWeight="SemiBold" Margin="0,0,0,7"/><DockPanel><Button x:Name="Browse" Content="选择" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="Folder" Padding="10" Background="White" BorderBrush="#D8E5E1" VerticalContentAlignment="Center"/></DockPanel></StackPanel>
  <StackPanel Grid.Row="3" Margin="0,15,0,0"><CheckBox x:Name="DesktopShortcut" IsChecked="True" FontSize="13" Content="创建桌面快捷方式" Margin="0,0,0,10"/><CheckBox x:Name="Mirrors" IsChecked="True" FontSize="12" Content="镜像优先（GHFast / GH-Proxy / GHProxy.net，GitHub 备用）"/><TextBlock Text="备用来源为第三方服务，所有文件均须通过固定 SHA-256 校验。建议预留 18 GB。" Foreground="#718784" FontSize="11" Margin="20,6,0,0"/></StackPanel>
  <StackPanel Grid.Row="4" Margin="0,18,0,0"><ProgressBar x:Name="Progress" Height="5" Foreground="#1B9684" Background="#DFEBE7" BorderThickness="0"/><TextBlock x:Name="Status" Text="正在自动检测已有安装……" TextWrapping="Wrap" Foreground="#56716C" FontSize="12" Margin="0,10,0,0" MinHeight="38" MaxHeight="65"/></StackPanel>
  <StackPanel Grid.Row="6" Margin="0,10,0,0"><TextBlock x:Name="SelectionInfo" Text="请勾选需要操作的组件" TextWrapping="Wrap" FontSize="12" Foreground="#56716C" Margin="0,0,0,12"/><Grid><StackPanel Orientation="Horizontal"><Button x:Name="Scan" Content="重新校验"/><Button x:Name="OpenApp" Content="打开软件" Margin="8,0,0,0"/><Button x:Name="Cancel" Content="停止" Background="Transparent" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Uninstall" Content="卸载所选" Background="#F5E8E5" Foreground="#A04732" Margin="0,0,10,0"/><Button x:Name="Start" Content="安装所选" Background="#157D70" Foreground="White" FontWeight="SemiBold"/></StackPanel></Grid></StackPanel>
 </Grid>
</Window>
