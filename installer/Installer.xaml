<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MoleculeStudio · 安装与组件管理" Width="900" Height="850" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Background="#F5F8F8" FontFamily="Microsoft YaHei UI" Foreground="#143B3A">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#E6EFED"/><Setter Property="Foreground" Value="#174C47"/><Setter Property="Padding" Value="14,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="FontSize" Value="15"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="ComponentCard" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Card" Background="White" BorderBrush="#DEE9E5" BorderThickness="2" CornerRadius="12" Padding="14,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="26" Height="26" CornerRadius="6" BorderBrush="#93B3AA" BorderThickness="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0"><TextBlock x:Name="Tick" Text="✓" FontSize="20" FontWeight="Bold" Foreground="White" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter Grid.Column="1"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="Background" Value="#157D70"/><Setter TargetName="Box" Property="BorderBrush" Value="#157D70"/><Setter TargetName="Card" Property="BorderBrush" Value="#157D70"/><Setter TargetName="Card" Property="Background" Value="#ECF7F2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid x:Name="Root" Margin="28,22,28,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel x:Name="Header">
   <TextBlock Text="MOLECULE STUDIO" FontSize="12" FontWeight="Bold" Foreground="#268C80"/>
   <TextBlock x:Name="HeaderTitle" Text="让灵感，成为结构。" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,7"/>
   <TextBlock Text="勾选要操作的组件，再点击安装或卸载。所选组件同时下载，每个下载完成即刻安装。" Foreground="#637B78" FontSize="13" TextWrapping="Wrap"/>
  </StackPanel>
  <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
   <StackPanel x:Name="Content">
    <UniformGrid x:Name="CardGrid" Columns="2">
     <Border Margin="0,0,10,10"><CheckBox x:Name="Pick0" Style="{StaticResource ComponentCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="核心工作台" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Background="#E0EDE7" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="State0" Text="检测中…" FontSize="11"/></Border></Grid><TextBlock Text="结构绘图 · 化学命名 · 核磁预测 · 三维构象" Foreground="#637B78" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="Hint0" FontSize="11" Foreground="#718784" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></CheckBox></Border>
     <Border Margin="0,0,10,10"><CheckBox x:Name="Pick1" Style="{StaticResource ComponentCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="AI 基础" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Background="#E0EDE7" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="State1" Text="检测中…" FontSize="11"/></Border></Grid><TextBlock Text="AI 助手 · 检索 · 对话画图；需配置自己的 AI 服务" Foreground="#637B78" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="Hint1" FontSize="11" Foreground="#718784" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></CheckBox></Border>
     <Border Margin="0,0,10,10"><CheckBox x:Name="Pick2" Style="{StaticResource ComponentCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="AI 高级" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Background="#E0EDE7" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="State2" Text="检测中…" FontSize="11"/></Border></Grid><TextBlock Text="高级绘图插件；需先安装 AI 基础" Foreground="#637B78" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="Hint2" FontSize="11" Foreground="#718784" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></CheckBox></Border>
     <Border Margin="0,0,10,10"><CheckBox x:Name="Pick3" Style="{StaticResource ComponentCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="图片识别" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Background="#E0EDE7" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="State3" Text="检测中…" FontSize="11"/></Border></Grid><TextBlock Text="图片 / PDF 转可编辑结构 · 本地运行" Foreground="#637B78" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="Hint3" FontSize="11" Foreground="#718784" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></CheckBox></Border>
    </UniformGrid>
    <StackPanel Margin="0,8,0,0">
     <TextBlock Text="安装位置" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <DockPanel><Button x:Name="Browse" Content="选择" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="Folder" Padding="9" Background="White" BorderBrush="#D8E5E1" VerticalContentAlignment="Center" FontSize="12"/></DockPanel>
    </StackPanel>
    <StackPanel Margin="0,12,0,4">
     <CheckBox x:Name="DesktopShortcut" IsChecked="True" FontSize="13" Content="创建桌面快捷方式" Margin="0,0,0,8"/>
     <CheckBox x:Name="Mirrors" IsChecked="True" FontSize="12" Content="镜像优先（GHFast / GH-Proxy / GHProxy.net，GitHub 备用）"/>
     <TextBlock Text="备用来源为第三方服务，所有文件均须通过固定 SHA-256 校验。建议预留 18 GB。" Foreground="#718784" FontSize="11" Margin="20,5,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,6,0,0">
   <Grid x:Name="Job0" Margin="0,0,0,4" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="核心工作台" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#174C47"/><ProgressBar x:Name="Bar0" Grid.Column="1" Height="5" Foreground="#1B9684" Background="#DFEBE7" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="Job0Info" Grid.Column="2" FontSize="11" Foreground="#56716C" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
   <Grid x:Name="Job1" Margin="0,0,0,4" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="AI 基础" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#174C47"/><ProgressBar x:Name="Bar1" Grid.Column="1" Height="5" Foreground="#1B9684" Background="#DFEBE7" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="Job1Info" Grid.Column="2" FontSize="11" Foreground="#56716C" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
   <Grid x:Name="Job2" Margin="0,0,0,4" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="AI 高级" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#174C47"/><ProgressBar x:Name="Bar2" Grid.Column="1" Height="5" Foreground="#1B9684" Background="#DFEBE7" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="Job2Info" Grid.Column="2" FontSize="11" Foreground="#56716C" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
   <Grid x:Name="Job3" Margin="0,0,0,4" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="图片识别" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#174C47"/><ProgressBar x:Name="Bar3" Grid.Column="1" Height="5" Foreground="#1B9684" Background="#DFEBE7" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="Job3Info" Grid.Column="2" FontSize="11" Foreground="#56716C" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
   <ProgressBar x:Name="Progress" Height="4" Foreground="#1B9684" Background="#DFEBE7" BorderThickness="0"/>
   <TextBlock x:Name="Status" Text="正在自动检测已有安装……" TextWrapping="Wrap" Foreground="#56716C" FontSize="11.5" Margin="0,7,0,0" MinHeight="20" MaxHeight="46"/>
   <TextBlock x:Name="SelectionInfo" Text="请勾选需要操作的组件" TextWrapping="Wrap" FontSize="11.5" Foreground="#56716C" Margin="0,4,0,5"/>
   <WrapPanel x:Name="Actions" HorizontalAlignment="Right">
    <Button x:Name="Scan" Content="重新校验" Margin="0,4,0,0"/>
    <Button x:Name="OpenApp" Content="打开软件" Margin="8,4,0,0"/>
    <Button x:Name="Cancel" Content="停止" Background="Transparent" Margin="8,4,0,0"/>
    <Button x:Name="Uninstall" Content="卸载所选" Background="#F5E8E5" Foreground="#A04732" Margin="8,4,0,0"/>
    <Button x:Name="Start" Content="安装所选" Background="#157D70" Foreground="White" FontWeight="SemiBold" Margin="8,4,0,0"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
